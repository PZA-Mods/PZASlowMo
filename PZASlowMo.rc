// PZASlowMo.rc: Windows version resource for PZASlowMo.dll. Author: PZA. Licence: GPLv3 or later (see LICENSE).
// Bump SLOW_VER_* and SLOW_VER_STR together for every release (tools\make_release.py checks the DLL against SLOW_VER_STR).
// Plain ASCII on purpose: rc.exe of the VS2010 toolset reads the file in the ANSI code page.
#include <winres.h>

#define SLOW_VER_MAJOR 1
#define SLOW_VER_MINOR 1
#define SLOW_VER_PATCH 2
#define SLOW_VER_BUILD 0
#define SLOW_VER_STR   "1.1.2"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    SLOW_VER_MAJOR, SLOW_VER_MINOR, SLOW_VER_PATCH, SLOW_VER_BUILD
 PRODUCTVERSION SLOW_VER_MAJOR, SLOW_VER_MINOR, SLOW_VER_PATCH, SLOW_VER_BUILD
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "PZA"
            VALUE "FileDescription",  "PZA's SlowMo (RE_Kenshi plugin)"
            VALUE "FileVersion",      SLOW_VER_STR
            VALUE "InternalName",     "PZASlowMo"
            VALUE "LegalCopyright",   "Copyright (C) 2026 PZA. GNU GPL version 3 or later."
            VALUE "OriginalFilename", "PZASlowMo.dll"
            VALUE "ProductName",      "PZA's SlowMo"
            VALUE "ProductVersion",   SLOW_VER_STR
            VALUE "Comments",         "Source: https://github.com/PZA-Mods/PZASlowMo. Unofficial fan-made plugin for Kenshi."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
